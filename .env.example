# Copy this file to .env.local and fill in your values

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/authapp

# Secret used to sign session tokens (use a long random string, 32+ chars)
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
